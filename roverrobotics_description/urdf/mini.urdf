        <plugin filename="ignition-gazebo-joint-state-publisher-system"
            name="ignition::gazebo::systems::JointStatePublisher">
            <topic>/joint_states</topic>
        </plugin>


        <!-- dinamixel- camara rgbd -->
        <plugin filename="libignition-gazebo-joint-position-controller-system.so"
            name="ignition::gazebo::systems::JointPositionController">


            <joint_name>soporte_camaras_to_base_columnas</joint_name>


            <p_gain>0.0</p_gain>
            <i_gain>0.0</i_gain>
            <d_gain>0.0</d_gain>
            <topic>/tower_yaw/cmd_pos</topic>

        </plugin>

    </gazebo>

    <gazebo reference="fl_wheel_link">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp value="1000000.0" />
        <kd value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="fr_wheel_link">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp value="1000000.0" />
        <kd value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="rl_wheel_link">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp value="1000000.0" />
        <kd value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>
    <gazebo reference="rr_wheel_link">
        <mu1 value="200.0" />
        <mu2 value="200.0" />
        <kp value="1000000.0" />
        <kd value="1.0" />
        <minDepth>0.005</minDepth>
    </gazebo>

</robot>