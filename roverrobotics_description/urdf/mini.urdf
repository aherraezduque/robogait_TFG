            <!-- P1 mi Ts = 0.001-->
            <b_0>0.002294264339152</b_0>
            <b_1>0.002294264339152</b_1>
            <b_2>0.00</b_2>
            <a_0>1.00</a_0>
            <a_1>-0.995012468827930</a_1>
            <a_2>0.00</a_2>

            <!-- Con delay -->
            <enable_pure_delay>true</enable_pure_delay>
            <pure_delay_seconds>0.2</pure_delay_seconds>

            
            <!-- P2 el que usaba-->
            <!-- 0.001 -->
            <!-- b: num coef -->
            <!-- a: den coef -->
            <!-- <b_0>7.026962304015981e-07</b_0>
