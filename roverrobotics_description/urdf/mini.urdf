<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_mini">

    <!-- Robot Parameters -->
    <xacro:property name="wheel_z_offset" value="0.02" />
    <xacro:property name="wheel_x_offset" value="0.11" />
    <!-- <xacro:property name="front_wheel_x_offset" value="0.006" /> -->
    <xacro:property name="wheel_y_offset" value="0.162" />
    <xacro:property name="wheel_mass" value="3.62874" />
    <xacro:property name="chassis_mass" value="1.36078" />

    <!-- Part Includes - Payload, Sensors, Etc.. -->
    <xacro:property name="payload_z_offset" value="0.1645" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/rover_dev_payload.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/base_columnas.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/soporte_camaras.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/dynamixel.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/oak.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/rplidar_s2.urdf" />
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/imu.urdf" />
    

    <!-- <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/stereo_camera.urdf" /> -->
    <!-- <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/camera.urdf" /> -->
    <!-- <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/depth_camera.urdf" /> -->
    <xacro:include filename="$(find roverrobotics_description)/urdf/accessories/rgbd_camera.urdf" />

    <!-- Robot Description -->


    <link name="base_link" />

    <joint name="base_footprint_joint" type="fixed">
        <parent link="base_link"/>
        <child link="base_footprint"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
    
    <link name="base_footprint" />

    <link name="chassis_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 -0 1.5708" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/mini_chassis_new_color_fixed.dae" />
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 -0 1.5708" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/mini_chassis_new_color_fixed.dae" />
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0.02" rpy="0 0 0" />
        <mass value="${chassis_mass}" />
        <inertia ixx="0.006453" ixy="0" ixz="0" iyy="0.0117" iyz="0" izz="0.015812" />
    </inertial>
    </link>

    <joint name="base_to_chassis" type="fixed">
        <parent link="base_link" />
        <child link="chassis_link" />
        <origin xyz="0 0 0.061" />
    </joint>

    <link name="fl_wheel_link">
    <visual>
        <origin xyz="0 -0.08 0" rpy="1.57 3.1415 0" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 -0.08 0" rpy="1.57 3.1415 0" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.008093" ixy="0" ixz="0" iyy="0.014226" iyz="0" izz="0.008093" />
    </inertial>
    <mu>5.0</mu>
    </link>
    <joint name="fl_wheel_to_chassis" type="continuous">
        <parent link="chassis_link" />
        <child link="fl_wheel_link" />
        <axis xyz="0 1 0" />
        <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" />
        <!-- <origin xyz="${wheel_x_offset - front_wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}"/> -->
    </joint>

    <link name="fr_wheel_link">
    <visual>
        <origin xyz="0 0.08 0" rpy="1.57 3.1415 3.1415" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0.08 0" rpy="1.57 3.1415 3.1415" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.008093" ixy="0" ixz="0" iyy="0.014226" iyz="0" izz="0.008093" />
    </inertial>
    <mu>5.0</mu>
    </link>
    <joint name="fr_wheel_to_chassis" type="continuous">
        <parent link="chassis_link" />
        <child link="fr_wheel_link" />
        <axis xyz="0 1 0" />
        <origin xyz="${wheel_x_offset} ${-wheel_y_offset} ${wheel_z_offset}" />
        <!-- <origin xyz="${wheel_x_offset - front_wheel_x_offset}  ${-wheel_y_offset} ${wheel_z_offset}"/> -->
    </joint>

    <link name="rl_wheel_link">
    <visual>
        <origin xyz="0 -0.08 0" rpy="1.57 3.1415 0" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 -0.08 0" rpy="1.57 3.1415 0" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.008093" ixy="0" ixz="0" iyy="0.014226" iyz="0" izz="0.008093" />
    </inertial>
    <mu>5.0</mu>
    </link>
    <joint name="rl_wheel_to_chassis" type="continuous">
        <parent link="chassis_link" />
        <child link="rl_wheel_link" />
        <axis xyz="0 1 0" />
        <origin xyz="${-wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" />
    </joint>

    <link name="rr_wheel_link">
    <visual>
        <origin xyz="0 0.08 0" rpy="1.57 3.1415 3.1415" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0.08 0" rpy="1.57 3.1415 3.1415" />
        <geometry>
            <mesh filename="file://$(find roverrobotics_description)/meshes/wheel.dae" />
            <!-- <mesh filename="file://$(find roverrobotics_description)/meshes/REMESHED/65wheels_color_2dot3_4dot6.dae"/> -->
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="${wheel_mass}" />
        <inertia ixx="0.008093" ixy="0" ixz="0" iyy="0.014226" iyz="0" izz="0.008093" />
    </inertial>
    <mu>5.0</mu>
    </link>
    <joint name="rr_wheel_to_chassis" type="continuous">
        <parent link="chassis_link" />
        <child link="rr_wheel_link" />
        <axis xyz="0 1 0" />
        <origin xyz="${-wheel_x_offset} ${-wheel_y_offset} ${wheel_z_offset}" />
    </joint>

    <gazebo>
        <plugin name="ignition::gazebo::v6::systems::DiffDrive_second_order" filename="libdiff_drive_second_order.so">
            <num_wheel_pairs>2</num_wheel_pairs>
            <!-- Wheel Information -->
            <left_joint>rl_wheel_to_chassis</left_joint>
            <left_joint>fl_wheel_to_chassis</left_joint>
            <right_joint>rr_wheel_to_chassis</right_joint>
            <right_joint>fr_wheel_to_chassis</right_joint>
            <wheel_separation>0.26</wheel_separation>
            <wheel_radius>0.08</wheel_radius>

            <!-- Limits -->
            <max_linear_velocity>3</max_linear_velocity>
            <min_linear_velocity>-3</min_linear_velocity>
            <max_linear_acceleration>2</max_linear_acceleration>
            <min_linear_acceleration>-2</min_linear_acceleration>
            <!-- <max_linear_jerk>0.8</max_linear_jerk>
            <min_linear_jerk>-0.8</min_linear_jerk> -->

            <max_angular_velocity>2.5</max_angular_velocity>
            <min_angular_velocity>-2.5</min_angular_velocity>
            <max_angular_acceleration>2</max_angular_acceleration>
            <min_angular_acceleration>-2</min_angular_acceleration>
            <!-- <min_angular_jerk>0.8</min_angular_jerk>
            <max_angular_jerk>-0.8</max_angular_jerk> -->

            <!-- Output -->
            <frame_id>odom</frame_id>
            <child_frame_id>base_link</child_frame_id>

            <!-- Topics -->
            <topic>/cmd_vel</topic>  <!-- <topic>/cmd_vel_filtered</topic>   -->
            <odom_topic>/odometry/wheels</odom_topic>
            <tf_topic>/tf_gazebo</tf_topic>

            <!-- Second order filter -->
            <enable_second_order_filter>true</enable_second_order_filter>

            <!-- MODELOS NUEVOS DE 1 POLO -->

            <!-- Kp: 0.92 Tau = 0.48 Ts = 0.001 -->
            <!-- <b_0>0.00095733610822060363</b_0>
