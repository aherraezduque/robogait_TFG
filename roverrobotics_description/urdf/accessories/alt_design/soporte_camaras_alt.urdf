<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="soporte_camaras_alt">
    
    <!-- <xacro:property name="soporte_camaras_alt_z_offset" value="0.0511" />
    <xacro:property name="soporte_camaras_alt_y_offset" value="0.0350" /> -->


    <link name="soporte_camaras">
        <visual>
            <origin xyz="0 -0.0350 -0.0511" rpy="0 0 0" />
            <!-- <origin xyz="0 ${-soporte_camaras_alt_y_offset} ${-soporte_camaras_alt_z_offset}" rpy="0 0 0" /> -->
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/Soporte_Camara_alt_v2.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 -0.0350 -0.0511" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/Soporte_Camara_alt_v2.dae"/>
            </geometry>
        </collision>

    </link>

    <joint name="soporte_camaras_to_top_bearing" type="fixed">
        <parent link="top_bearing"/>
        <child link="soporte_camaras"/>
        <origin xyz="0 0.0350 0.0511" rpy="0 0 0"/>
        <!-- <origin xyz="0 ${soporte_camaras_alt_y_offset} ${soporte_camaras_alt_z_offset}" rpy="0 0 0"/> -->
        <!-- <axis xyz="0 1 0"/>  -->
    </joint>

</robot>