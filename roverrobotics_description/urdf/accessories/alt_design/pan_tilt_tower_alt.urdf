<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pan_tilt_tower">
    
    <link name="pan_tilt_tower_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/PanTiltTower_alt.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/PanTiltTower_alt.dae"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.1"/>
            <inertia ixx="0.0001" ixy="0" ixz="0"
                   iyy="0.0001" iyz="0"
                   izz="0.0001"/>
        </inertial>
    </link>

    <joint name="pan_tilt_tower_to_pan_tilt_base" type="revolute">
        <parent link="pan_tilt_base_link"/>
        <child link="pan_tilt_tower_link"/>
        <origin xyz="0 0 -0.0024"/>
        <!-- <origin xyz="0 0 -0.0024"/> -->
        <axis xyz="0 0 1"/>  
        <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="2.0"/>
    </joint>

</robot>