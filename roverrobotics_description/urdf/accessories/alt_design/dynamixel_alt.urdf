<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dynamixel">
    
    <link name="dynamixel_link"/>

    <joint name="dynamixel_to_pan_tilt_tower" type="fixed">
        <parent link="pan_tilt_tower_link"/>
        <child link="dynamixel_link"/>
        <origin xyz="-0.04942 0.00845 0.0286" rpy="0 0 0"/>
    </joint>
    
    <link name="dynamixel_top_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/DynamixelTop_alt.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ALT_DESIGN/DynamixelTop_alt.dae"/>
            </geometry>
        </collision>
        
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.9"/>
            <inertia ixx="0.0005" ixy="0" ixz="0"
                   iyy="0.0005" iyz="0"
                   izz="0.0005"/>
        </inertial>
    </link>

    <joint name="dynamixel_top_to_dynamixel" type="revolute">
        <parent link="dynamixel_link"/>
        <child link="dynamixel_top_link"/>
        <origin xyz="0 0 0"/>
        <!-- <origin xyz="0 0 -0.0024"/> -->
        <axis xyz="0 1 0"/>  
        <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="2.0"/>
    </joint>

    <link name="dynamixel_arm_link"/>

    <joint name="dynamixel_arm_to_dynamixel_top" type="fixed">
        <parent link="dynamixel_top_link"/>
        <child link="dynamixel_arm_link"/>
        <origin xyz="-0.01006 0.0021 -0.00687"/>
    </joint>


</robot>