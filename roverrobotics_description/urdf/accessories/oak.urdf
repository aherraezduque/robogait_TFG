<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_mini_oak">
    
    <link name="oak">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Oak.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Oak.dae"/>
            </geometry>
        </collision>

    </link>

    <joint name="oak_to_soporte_camaras_orbec" type="fixed">
        <parent link="soporte_camaras_orbec"/>
        <child link="oak"/>
        <origin xyz="0 0 0"/>
    </joint>


</robot>