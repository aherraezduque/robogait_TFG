<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="oak">
    
    <link name="oak_link">
        <visual>
            <origin xyz="-0.02213 0 -0.11769" rpy="0 0 0" />
            <!-- <origin xyz="0.03296 0 -0.06407" rpy="0 0 0" />  +  <origin xyz="-0.05509 0 -0.05362" rpy="0 0 0"/> -->
            <!-- dist orbec to oak  + offsets visual soporte_camaras -->
            
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Oak.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="-0.02213 0 -0.11769" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Oak.dae"/>
            </geometry>
        </collision>

    </link>

    <joint name="oak_to_orbbec_camera_assembly" type="fixed">
        <parent link="orbbec_camera_assembly_link"/>
        <child link="oak_link"/>
        <origin xyz="-0.03296 0 0.06407" rpy="0 0 0"/>
    </joint>


</robot>