<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_mini_base_columnas">
    
    <link name="base_columnas">
        <visual>
            <origin xyz="0 0 0.194" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ColumnasBase.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0.194" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/ColumnasBase.dae"/>
            </geometry>
        </collision>

    </link>

    <joint name="base_columnas_to_payload" type="fixed">
        <parent link="payload_link"/>
        <child link="base_columnas"/>
        <origin xyz="0 0 0"/>
    </joint>


</robot>