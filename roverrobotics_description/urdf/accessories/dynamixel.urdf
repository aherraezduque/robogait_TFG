<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rover_mini_dynamixel">
    
    <link name="dynamixel">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Dynamixel.dae"/>
            </geometry>
        </visual>

        <collision>
            <origin xyz="0 0 0" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Dynamixel.dae"/>
            </geometry>
        </collision>
    </link>

    <joint name="dynamixel_to_base_columnas" type="fixed">
        <parent link="base_columnas"/>
        <child link="dynamixel"/>
        <origin xyz="0 0 -0.0111"/>
    </joint>

    <!-- DYNAMIXEL TOP - ROTATION -->
    <link name="dynamixel_top">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Dynamixel_top.dae"/>
            </geometry>
        </visual>

        <!-- <collision>
            <origin xyz="0 0 0" rpy="0 0 3.14159" />
            <geometry>
                <mesh filename="file://$(find roverrobotics_description)/meshes/Dynamixel_top.dae"/>
            </geometry>
        </collision> -->

        <!-- <inertial>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <mass value="0.20" />
            <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.01"/>
        </inertial> -->
    </link>

    <joint name="dynamixel_top_to_dynamixel" type="revolute">
        <parent link="dynamixel"/>
        <child link="dynamixel_top"/>
        <origin xyz="0 0 0"/>
        <axis xyz="0 0 1"/>
        <limit lower="-1.5708" upper="1.5708" effort="5.0" velocity="2.0"/>
    </joint>

</robot>